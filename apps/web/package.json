    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.0.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "wrangler": "^4.20.0"
