{
    "name": "@latino-canon/web",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --port 3000",
        "dev:local": "LOCAL_DEV=1 next dev --port 3000",
        "build": "next build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "typecheck": "tsc -p tsconfig.json",
        "cf-typegen": "wrangler types"
    },
    "dependencies": {
        "@latino-canon/core": "workspace:*",
        "next": "^15.1.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.0.0",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "typescript": "^5.7.2",
        "wrangler": "^4.20.0"
    }
}