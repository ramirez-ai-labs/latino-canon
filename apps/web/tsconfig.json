{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "types": [
      "react",
      "@cloudflare/workers-types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@latino-canon/core": [
        "../../packages/core/src/index.ts"
      ],
      "@latino-canon/core/*": [
        "../../packages/core/src/*"
      ]
    },
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "src",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    ".open-next"
  ]
}
