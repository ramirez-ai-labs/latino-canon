{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Test-only worker config for @cloudflare/vitest-pool-workers. Deliberately trimmed to
	// the DB binding: it's all the lexical-retrieval regression test needs, and it keeps
	// this suite fully local (no Cloudflare account, no `remote: true` bindings like the
	// real wrangler.jsonc's Vectorize/AI, which would need live credentials to even boot).
	"name": "latino-canon-api-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-15",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "latino-canon-test",
			"database_id": "test-fixture-db"
		}
	],
	"r2_buckets": [
		{
			"binding": "POSTERS",
			"bucket_name": "latino-canon-posters-test"
		}
	]
}
