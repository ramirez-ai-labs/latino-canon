{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "latino-canon-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// traces.head_sampling_rate: 1 (100%) is deliberate at this project's request volume -
	// full visibility into every request's AI.run()/D1/Vectorize call chain matters more
	// right now than the cost of sampling down, which only pays off at real production
	// traffic. Free on the Workers Free plan; only OTel *export* of traces needs Paid.
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"ai": {
		"binding": "AI"
	},
	// The deployed version's id, used in search.ts's cache key so every deploy starts with an
	// empty result cache - results computed by the previous code are never served (and the
	// post-deploy retrieval eval never grades the old code).
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "latino-canon-titles",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "latino-canon",
			"database_id": "d6e2a10c-d436-4512-991e-cbc66918a777",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "3cbc7e31b2de454db393f22775cc17ce"
		}
	],
	"r2_buckets": [
		{
			"binding": "POSTERS",
			"bucket_name": "latino-canon-posters"
		}
	],
	"vars": {
		"AI_GATEWAY_ID": "latino-canon",
		"SEARCH_CACHE_TTL_SECONDS": "3600"
	}
	// No secrets - Workers AI via the native binding needs no account id or API key.
}