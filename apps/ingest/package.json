{
  "name": "@latino-canon/ingest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts --max-warnings 2",
    "test": "vitest run && vitest run --config vitest.d1.config.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:only": "tsx scripts/seed-only.ts",
    "ingest:refs": "tsx scripts/ingest-refs.ts",
    "backfill:gender": "tsx scripts/backfill-gender.ts",
    "backfill:genres": "tsx scripts/backfill-genres.ts",
    "backfill:content-advisory": "tsx scripts/backfill-content-advisory.ts",
    "regenerate:blurbs": "tsx scripts/regenerate-blurbs.ts",
    "rebuild:vectors": "tsx scripts/rebuild-vectors.ts"
  },
  "dependencies": {
    "@latino-canon/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vite": "^7.3.6",
    "wrangler": "^4.146.0"
  }
