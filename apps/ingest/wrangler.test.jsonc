{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Test-only worker config for @cloudflare/vitest-pool-workers, mirroring
	// apps/api/wrangler.test.jsonc. Deliberately trimmed to the DB binding: it's all
	// persist.ts's D1-only functions and maintenance.ts's retryErroredJobs need, and it
	// keeps this suite fully local (no Cloudflare account, no live Vectorize/AI/
	// Workflows credentials like the real wrangler.jsonc would need to even boot).
	"name": "latino-canon-ingest-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-15",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "latino-canon-test",
			"database_id": "test-fixture-db"
		}
	]
}
