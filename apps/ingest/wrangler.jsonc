{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "latino-canon-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "ai": { "binding": "AI" },

  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "latino-canon-titles" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latino-canon",
      "database_id": "d6e2a10c-d436-4512-991e-cbc66918a777"
    }
  ],

  "r2_buckets": [
    { "binding": "POSTERS", "bucket_name": "latino-canon-posters" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "3cbc7e31b2de454db393f22775cc17ce" }
  ],

  "workflows": [
    {
      "binding": "INGEST_WORKFLOW",
      "name": "latino-canon-ingest",
      "class_name": "IngestWorkflow"
    }
  ],

  "triggers": {
    // daily: ingest the next seed titles (ingest-queue.ts), retry errored jobs,
    // refresh popularity/ratings
    "crons": ["0 8 * * *"]
  },

  "vars": {
    "AI_GATEWAY_ID": "latino-canon",
    // Seed titles ingested per day. Each costs 70B classify + blurb neurons from the
    // account-wide 10k/day budget; 5 leaves room for live search and one eval.
    "INGEST_QUEUE_PER_DAY": "5"
  }

  // Secrets: TMDB_API_KEY, OMDB_API_KEY, INGEST_ADMIN_TOKEN
}
