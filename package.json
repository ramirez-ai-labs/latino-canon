    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.28"
